rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // 管理員：custom claim level >= 4（由 tools/sync_user_claims.py 設定）
    function isAdmin() {
      return request.auth != null && request.auth.token.level is int
             && request.auth.token.level >= 4;
    }

    // 商品：登入可讀（已不含 cost，只有報價 quotes）、僅管理員可寫
    match /Products/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 成本價：機密，僅管理員可讀寫
    match /ProductsCost/{id} {
      allow read, write: if isAdmin();
    }

    // 使用者權限（含等級）：
    //  - 管理員可讀寫全部
    //  - 一般使用者僅能讀「自己」那筆（doc id = 自己的 email 小寫）；auth.js 要靠它取得自身 level
    //  - 寫入一律限管理員，避免客戶竄改自己/他人的等級
    match /Users/{id} {
      allow read: if isAdmin()
                  || (isSignedIn() && request.auth.token.email is string
                      && id == request.auth.token.email.lower());
      allow write: if isAdmin();
    }

    // 報價歷史 / 點擊統計：登入者可新增，僅管理員可讀
    match /QuoteHistory/{id} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn();
    }
    match /ProductClicks/{id} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn();
    }

    // 其餘一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
